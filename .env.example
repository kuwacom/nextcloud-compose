# Nextcloudの設定
NEXTCLOUD_VERSION=35                                        # 使用したいNextcloudのバージョン 35が最新(2026/10/22現在)
HTTP_PORT=80                                                # Nextcloudを公開するポート
NEXTCLOUD_TRUSTED_DOMAINS=nextcloud localhost <your_domain> # 信頼するドメイン (スペース区切りで複数指定可能)
ADMIN_USERNAME=<admin_user_name>                            # Nextcloudの管理者ユーザー名
ADMIN_PASSWORD=<your_password>                              # Nextcloudの管理者パスワード
DEFAULT_LANGUAGE=ja                                         # デフォルトの言語 (例: ja, en)

# データベース (PostgreSQL) の設定
DB_NAME=nextcloud                                           # データベース名
DB_USER=nextcloud                                           # データベースのユーザー名
DB_PASSWORD=<your_password>                                 # データベースのパスワード
DB_DATA_DIR=./postgres                                      # PostgreSQLのデータ配置先 (ローカルディスクを推奨)

# MariaDB (旧DB、移行時のみ使用)
MARIADB_ROOT_PASSWORD=<your_password>                       # 移行用MariaDBのrootパスワード (既存DBの値。旧composeでは nextcloud)

# CloudFlareの設定
CLOUDFLARE_TUNNEL_TOKEN=<your_cloudflare_tunnel_token>      # CloudFlareのトンネルトークン
